---
import "../styles/global.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-600.css";
import { navItems, site } from "../data/site.js";

const {
  title = site.title,
  description = site.description,
  canonical,
  article,
} = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalUrl = canonical || new URL(currentPath, Astro.site).toString();
const ogImageUrl = new URL(
  "/img/shevashen-og-poster.png",
  Astro.site,
).toString();
const structuredData = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: article.title,
      description,
      datePublished: article.date,
      author: {
        "@type": "Person",
        name: site.name,
        url: new URL("/about/", Astro.site).toString(),
      },
      mainEntityOfPage: canonicalUrl,
      image: ogImageUrl,
      keywords: article.tags.join(", "),
      articleSection: article.topic,
    }
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Sheva Shen — Software Engineering to AI Systems"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    {
      article && (
        <meta property="article:published_time" content={article.date} />
      )
    }
    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
        />
      )
    }
    <script is:inline>
      // Apply the saved preference before paint; storage may be unavailable.
      try {
        const theme = localStorage.getItem("sheva-theme");
        if (theme === "light" || theme === "dark")
          document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header container">
        <nav class="nav" aria-label="Primary">
          <a class="brand" href="/"
            >{site.name}<span aria-hidden="true">↗</span></a
          >
          <div class="nav-links">
            {
              navItems.map((item) => {
                const isCurrent =
                  item.href === "/"
                    ? currentPath === "/"
                    : currentPath.startsWith(item.href);
                return (
                  <a
                    href={item.href}
                    aria-current={isCurrent ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                );
              })
            }
            <button
              class="theme-toggle"
              type="button"
              aria-label="Dark mode"
              aria-pressed="false"
              hidden><span aria-hidden="true">◐</span></button
            >
          </div>
        </nav>
      </header>
      <div class="journal-ribbon container">
        <span><i aria-hidden="true"></i>Independent engineering journal</span
        ><span>Thinking in public / {new Date().getFullYear()}</span>
      </div>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer container">
        <div>
          <p class="footer-motto">
            Curiosity is an engineering discipline.
          </p><small
            >© {new Date().getFullYear()} Sheva Shen · Notes on building reliable
            AI systems.</small
          >
        </div>
        <nav aria-label="Footer">
          <a href="/contact/">Contact ↗</a><a href="/archive/">Archive</a><a
            href="#top">Back to top ↑</a
          >
        </nav>
      </footer>
    </div>
    <script src="../scripts/theme.ts"></script>
  </body>
</html>
