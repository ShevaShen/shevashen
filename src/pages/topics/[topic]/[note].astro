---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import RuntimeDiagram from "../../../components/RuntimeDiagram.astro";
import WritingList from "../../../components/WritingList.astro";
import { topics, allNotes } from "../../../data/topics.js";
import { formatDate } from "../../../utils/dates.js";

const noteModules = import.meta.glob("../../../content/notes/*.md", {
  eager: true,
});
const noteContentBySlug = Object.fromEntries(
  Object.entries(noteModules).map(([path, module]) => [
    path.split("/").pop().replace(".md", ""),
    module,
  ]),
);
export function getStaticPaths() {
  return topics.flatMap((topic) =>
    topic.notes.map((note) => ({
      params: { topic: topic.slug, note: note.slug },
      props: { topic, note },
    })),
  );
}
const { topic, note } = Astro.props;
const markdown = noteContentBySlug[note.slug];
const Content = markdown.default;
const headings = markdown
  .getHeadings()
  .filter((heading) => heading.depth === 2);
const ordered = [...allNotes].sort((a, b) => b.date.localeCompare(a.date));
const index = ordered.findIndex((item) => item.slug === note.slug);
const newer = ordered[index - 1];
const older = ordered[index + 1];
const related = ordered
  .filter((item) => item.topicSlug === topic.slug && item.slug !== note.slug)
  .slice(0, 2);
---

<BaseLayout
  title={`${note.title} — Sheva Shen`}
  description={note.summary}
  article={{ ...note, topic: topic.title }}
>
  <div class="reading-progress" aria-hidden="true">
    <span id="reading-progress"></span>
  </div>
  <article>
    <header class="container article-header">
      <a class="text-link back-link" href="/topics/">← All writing</a>
      <div class="article-heading-grid">
        <div>
          <a class="section-kicker" href={`/topics/${topic.slug}/`}
            >{topic.title} / Field notes</a
          ><h1>{note.title}</h1><p class="article-subtitle">{note.summary}</p>
        </div>
        <dl class="article-details">
          <div>
            <dt>Published</dt><dd>
              <time datetime={note.date}>{formatDate(note.date, "long")}</time>
            </dd>
          </div><div><dt>Reading time</dt><dd>{note.readingTime}</dd></div><div>
            <dt>Topics</dt><dd>
              <a href={`/topics/${topic.slug}/`}>{topic.title}</a>
            </dd>
          </div>
        </dl>
      </div>
      {
        note.slug === "openclaw-concurrency-is-not-isolation" && (
          <RuntimeDiagram />
        )
      }
    </header>
    <div class="container article-body-grid">
      {
        headings.length > 0 && (
          <aside class="article-toc">
            <nav aria-label="On this page">
              <>
                <p class="section-kicker">On this page</p>
                <ol>
                  {headings.map((heading, i) => (
                    <li>
                      <a href={`#${heading.slug}`}>
                        <span aria-hidden="true">
                          {String(i + 1).padStart(2, "0")} /{" "}
                        </span>
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </>
            </nav>
          </aside>
        )
      }
      <div class="prose" id="article-content">
        <Content /><p class="article-end">— End of note / Thanks for reading</p>
      </div>
      <div class="article-rail" aria-hidden="true">
        Sheva Shen<br />Field notes<br />{note.date.slice(0, 4)}
      </div>
    </div>
    <footer class="container article-endmatter">
      <div class="author-note">
        <p class="section-kicker">Written by Sheva Shen</p><p>
          A Staff Engineer documenting the work of making AI systems useful,
          reliable, and understandable.
        </p><a class="text-link" href="/about/">About the author ↗</a>
      </div>
      <ul class="tag-list" aria-label="Article tags">
        {
          note.tags.map((tag) => (
            <li>
              <a href={`/topics/?tag=${encodeURIComponent(tag)}#writing-list`}>
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
      <nav class="adjacent-notes" aria-label="More writing">
        {
          newer && (
            <a href={newer.href} rel="prev">
              <>
                <span>← Newer note</span>
                <strong>{newer.title}</strong>
              </>
            </a>
          )
        }{
          older && (
            <a href={older.href} rel="next">
              <>
                <span>Older note →</span>
                <strong>{older.title}</strong>
              </>
            </a>
          )
        }
      </nav>
    </footer>
  </article>
  {
    related.length > 0 && (
      <section class="container related-notes">
        <>
          <p class="section-kicker">Keep exploring / {topic.title}</p>
          <h2>Related notes.</h2>
          <WritingList notes={related} />
        </>
      </section>
    )
  }
  <script src="../../../scripts/reading.ts"></script>
</BaseLayout>
